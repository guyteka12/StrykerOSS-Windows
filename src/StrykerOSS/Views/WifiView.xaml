<UserControl x:Class="StrykerOSS.Views.WifiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vms="clr-namespace:StrykerOSS.ViewModels">
    <Grid Background="{StaticResource BgBrush}" TextElement.Foreground="{StaticResource TextBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Wi-Fi Networks" Style="{StaticResource H1}"/>
            <TextBlock Text="Real scan, connect and profile management through the built-in Windows wireless adapter (Native Wifi API)." Style="{StaticResource Caption}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- ================= main column ================= -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- adapters card -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ADAPTERS" Style="{StaticResource Section}"/>
                        <ItemsControl ItemsSource="{Binding Adapters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Border Margin="8,0,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource BadgeSuccess}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Connected}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="CONNECTED" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                            </Border>
                                            <Border Margin="8,0,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource BadgeMuted}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Connected}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="DISCONNECTED" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                            </Border>
                                            <TextBlock Text="{Binding Description, StringFormat=' - {0}'}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SsidText}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <TextBlock.Text>
                                                    <Binding Path="SsidText" StringFormat=" - {0}"/>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- scan + networks card -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Scan" Style="{StaticResource BtnPrimary}" Command="{Binding ScanCommand}"/>
                            <Button Content="Cancel" Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Command="{Binding ScanCancelCommand}"/>
                            <Button Content="Refresh" Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Command="{Binding LoadCommand}"/>
                            <ProgressBar Style="{StaticResource ProgressAccent}" Width="120" IsIndeterminate="{Binding IsBusy}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Networks}"
                                 SelectedItem="{Binding SelectedNetwork, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="12"
                                 Foreground="{StaticResource TextBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavListBoxItem}"/>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Ssid}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                                <Border Margin="10,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource BadgeSuccess}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Connected}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="CONNECTED" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Bssid}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Border Style="{StaticResource BadgeInfo}">
                                                    <TextBlock Text="{Binding Channel}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                </Border>
                                                <Border Style="{StaticResource BadgeInfo}" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding Band}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                </Border>
                                                <Border Style="{StaticResource BadgeWarn}" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding Signal}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                </Border>
                                                <Border Style="{StaticResource BadgeMuted}" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding Auth}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                </Border>
                                                <Border Style="{StaticResource BadgeMuted}" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding Encryption}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ================= side column ================= -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- selected network / connect -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SELECTED NETWORK" Style="{StaticResource Section}"/>
                            <TextBlock Text="{Binding SelectedNetwork.Ssid, FallbackValue='Nothing selected', TargetNullValue='Nothing selected'}"
                                       Style="{StaticResource H2}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedNetwork.Bssid, FallbackValue='Pick a network from the list', TargetNullValue='Pick a network from the list'}"
                                       Style="{StaticResource Caption}"/>
                            <TextBlock Text="Passphrase / key" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
                            <PasswordBox Style="{StaticResource PassBox}"
                                         vms:PasswordHelper.Bind="True"
                                         vms:PasswordHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Connect" Style="{StaticResource BtnPrimary}" Command="{Binding ConnectCommand}"/>
                                <Button Content="Disconnect" Style="{StaticResource BtnDanger}" Margin="8,0,0,0" Command="{Binding DisconnectCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- profiles -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SAVED PROFILES" Style="{StaticResource Section}"/>
                            <ListBox ItemsSource="{Binding Profiles}"
                                     SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" MaxHeight="190"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavListBoxItem}"/>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Body}" FontSize="13"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1" Style="{StaticResource BadgeInfo}" Margin="8,0,8,0">
                                                <TextBlock Text="{Binding Auth}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                            </Border>
                                            <Button Grid.Column="2" Content="Delete" Style="{StaticResource BtnDanger}" FontSize="11" Padding="8,4"
                                                    Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- note -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="REAL HARDWARE" Style="{StaticResource Section}"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Uses the built-in Windows Wi-Fi adapter (Native Wifi API) — no external hardware required."/>
                        </StackPanel>
                    </Border>

                    <!-- educational reminder -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="EDUCATIONAL USE ONLY" Style="{StaticResource Section}"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Connecting to, scanning or profiling networks you do not own or lack written permission to test is illegal. Use this module only on your own lab networks."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
