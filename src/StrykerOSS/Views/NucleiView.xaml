<UserControl x:Class="StrykerOSS.Views.NucleiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BgBrush}" TextElement.Foreground="{StaticResource TextBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Web Scanner (Nuclei)" Style="{StaticResource H1}"/>
            <TextBlock Text="Real projectdiscovery nuclei: template-based vulnerability scanning of web targets."
                       Style="{StaticResource Caption}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ============ left: tool + config + log ============ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- install card -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TOOL" Style="{StaticResource Section}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Install / Update" Style="{StaticResource BtnPrimary}"
                                    Command="{Binding InstallCommand}" VerticalAlignment="Center" Margin="12,0,0,0"
                                    ToolTip="Downloads the official pinned nuclei release (windows x64) into the tools folder"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding InstallStatus}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                <TextBlock Text="Official projectdiscovery nuclei - pinned v3.3.9 windows x64" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- targets card -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TARGETS" Style="{StaticResource Section}"/>
                        <TextBox Style="{StaticResource InputBox}" AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding TargetsText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="One host or URL per line (http:// is added when the scheme is missing)"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="severity:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox Content="info" IsChecked="{Binding SevInfo}" Margin="0,0,10,0"/>
                            <CheckBox Content="low" IsChecked="{Binding SevLow}" Margin="0,0,10,0"/>
                            <CheckBox Content="medium" IsChecked="{Binding SevMedium}" Margin="0,0,10,0"/>
                            <CheckBox Content="high" IsChecked="{Binding SevHigh}" Margin="0,0,10,0"/>
                            <CheckBox Content="critical" IsChecked="{Binding SevCritical}" Margin="0,0,10,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="tags:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Style="{StaticResource InputBox}" Width="300"
                                     Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Optional nuclei template tags, comma or space separated (e.g. cve,rce)"/>
                            <Button Content="Run scan" Style="{StaticResource BtnPrimary}" Command="{Binding RunScanCommand}" Margin="10,0,0,0"/>
                            <Button Content="Cancel" Style="{StaticResource BtnDanger}" Command="{Binding CancelScanCommand}"
                                    Margin="8,0,0,0" IsEnabled="{Binding IsBusy}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- live log card -->
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="LIVE LOG" Style="{StaticResource Section}"/>
                            <ProgressBar Style="{StaticResource ProgressAccent}" IsIndeterminate="{Binding IsBusy}" Margin="0,0,0,4"/>
                        </StackPanel>
                        <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding LogLines}"
                                 FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextBrush}"
                                 VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ============ right: findings ============ -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Export CSV" Style="{StaticResource BtnGhost}" Command="{Binding ExportCsvCommand}"/>
                            <Button Content="Open raw JSONL" Style="{StaticResource BtnGhost}" Command="{Binding OpenRawCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Findings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Padding="10,3" CornerRadius="999" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="CRITICAL">
                                                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="HIGH">
                                                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="MEDIUM">
                                                                    <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="LOW">
                                                                    <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="Bold"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding MatchedAt, StringFormat='matched: {0}'}"
                                                       Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
