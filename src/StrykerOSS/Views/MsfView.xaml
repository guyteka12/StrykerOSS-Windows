<UserControl x:Class="StrykerOSS.Views.MsfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </UserControl.Resources>
    <Grid Background="{StaticResource BgBrush}" TextElement.Foreground="{StaticResource TextBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Metasploit" Style="{StaticResource H1}"/>
            <TextBlock Text="Real msfrpcd MSGRPC client, module runner and msfvenom payload generator."
                       Style="{StaticResource Caption}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1100">

                <!-- educational warning -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource BadgeDanger}" VerticalAlignment="Center">
                            <TextBlock Text="AUTHORIZED TARGETS ONLY" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                        </Border>
                        <TextBlock Text="Only use against systems you are authorized to test."
                                   Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- detection status -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="FRAMEWORK DETECTION" Style="{StaticResource Section}" Margin="0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border Style="{StaticResource BadgeSuccess}" Visibility="{Binding Detected, Converter={StaticResource B2V}}">
                                    <TextBlock Text="FOUND" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                </Border>
                                <Border Style="{StaticResource BadgeDanger}" Visibility="{Binding ShowNotFound, Converter={StaticResource B2V}}">
                                    <TextBlock Text="NOT FOUND" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Detect" Style="{StaticResource BtnPrimary}" Command="{Binding DetectCommand}"/>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding MsfPathDisplay, StringFormat='msfconsole: {0}'}"
                                   Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   Visibility="{Binding Detected, Converter={StaticResource B2V}}"/>
                        <TextBlock Text="Install from metasploit.com or use WSL; start msfrpcd -P pass -S false"
                                   Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- msgrpc connection -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MSGRPC CONNECTION" Style="{StaticResource Section}" Margin="0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border Style="{StaticResource BadgeSuccess}" Visibility="{Binding IsConnected, Converter={StaticResource B2V}}">
                                    <TextBlock Text="CONNECTED" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                </Border>
                                <Border Style="{StaticResource BadgeMuted}" Visibility="{Binding IsOffline, Converter={StaticResource B2V}}">
                                    <TextBlock Text="OFFLINE" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Host" Style="{StaticResource Caption}"/>
                                <TextBox Style="{StaticResource InputBox}" Width="150"
                                         Text="{Binding RpcHost, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Port" Style="{StaticResource Caption}"/>
                                <TextBox Style="{StaticResource InputBox}" Width="80"
                                         Text="{Binding RpcPort, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="User" Style="{StaticResource Caption}"/>
                                <TextBox Style="{StaticResource InputBox}" Width="120"
                                         Text="{Binding RpcUser, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Pass" Style="{StaticResource Caption}"/>
                                <TextBox Style="{StaticResource InputBox}" Width="140"
                                         Text="{Binding RpcPass, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <Button Content="Save" Style="{StaticResource BtnGhost}" Command="{Binding SaveRpcCommand}"
                                    Margin="0,17,0,0"/>
                            <Button Content="Connect" Style="{StaticResource BtnPrimary}" Command="{Binding ConnectRpcCommand}"
                                    Margin="8,17,0,0"/>
                            <Button Content="Disconnect" Style="{StaticResource BtnGhost}" Command="{Binding DisconnectCommand}"
                                    Margin="8,17,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- sessions -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SESSIONS" Style="{StaticResource Section}" Margin="0"/>
                            <Button Grid.Column="1" Content="Refresh" Style="{StaticResource BtnGhost}"
                                    Command="{Binding RefreshSessionsCommand}"/>
                        </Grid>
                        <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding Sessions}" Height="210"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Id, StringFormat='#{0}'}" Style="{StaticResource Body}"
                                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Border Style="{StaticResource BadgeInfo}" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                </Border>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TunnelPeer, StringFormat='peer {0}'}" Style="{StaticResource Caption}"/>
                                                    <TextBlock Text="{Binding TargetHost, StringFormat='host {0}'}" Style="{StaticResource Caption}"/>
                                                    <TextBlock Text="{Binding Platform, StringFormat='platform {0}'}" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Kill" Style="{StaticResource BtnDanger}"
                                                    Command="{Binding DataContext.KillSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- modules -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="MODULES" Style="{StaticResource Section}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Style="{StaticResource InputBox}" Width="280"
                                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Search" Style="{StaticResource BtnPrimary}" Command="{Binding SearchCommand}"
                                    Margin="10,0,0,0"/>
                            <Button Content="Recent exploits" Style="{StaticResource BtnGhost}"
                                    Command="{Binding RecentExploitsCommand}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding Modules}" Height="260"
                                 Margin="0,12,0,0" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FullName}" Style="{StaticResource Body}" FontWeight="Bold"/>
                                                    <Border Style="{StaticResource BadgeSuccess}" Margin="10,0,0,0"
                                                            Visibility="{Binding IsHighRank, Converter={StaticResource B2V}}">
                                                        <TextBlock Text="{Binding Rank}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                    </Border>
                                                    <Border Style="{StaticResource BadgeMuted}" Margin="10,0,0,0"
                                                            Visibility="{Binding IsManualRank, Converter={StaticResource B2V}}">
                                                        <TextBlock Text="{Binding Rank}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                    </Border>
                                                    <Border Style="{StaticResource BadgeWarn}" Margin="10,0,0,0"
                                                            Visibility="{Binding IsOtherRank, Converter={StaticResource B2V}}">
                                                        <TextBlock Text="{Binding Rank}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                    </Border>
                                                    <Border Style="{StaticResource BadgeInfo}" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Run" Style="{StaticResource BtnGhost}" VerticalAlignment="Top"
                                                    Command="{Binding DataContext.RunModuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- options mini-panel for the selected module -->
                        <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12,10" Margin="0,12,0,0"
                                Visibility="{Binding ModuleSelected, Converter={StaticResource B2V}}">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedModule.FullName, StringFormat='Options for {0}'}"
                                           Style="{StaticResource Caption}" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="RHOSTS" Style="{StaticResource Caption}"/>
                                        <TextBox Style="{StaticResource InputBox}" Width="160"
                                                 Text="{Binding RunRhosts, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="LHOST" Style="{StaticResource Caption}"/>
                                        <TextBox Style="{StaticResource InputBox}" Width="140"
                                                 Text="{Binding RunLhost, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="LPORT" Style="{StaticResource Caption}"/>
                                        <TextBox Style="{StaticResource InputBox}" Width="90"
                                                 Text="{Binding RunLport, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <Button Content="Execute" Style="{StaticResource BtnDanger}" Command="{Binding ExecuteModuleCommand}"
                                            VerticalAlignment="Bottom"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Console output" Style="{StaticResource Caption}" Margin="0,12,0,4" FontWeight="Bold"/>
                        <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding ConsoleLines}" Height="200"
                                 FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextBrush}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel"/>
                    </StackPanel>
                </Border>

                <!-- payload generator -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PAYLOAD GENERATOR (msfvenom)" Style="{StaticResource Section}" Margin="0"/>
                            <Border Grid.Column="1" Style="{StaticResource BadgeSuccess}"
                                    Visibility="{Binding PayloadSaved, Converter={StaticResource B2V}}">
                                <TextBlock Text="SAVED" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Payload" Style="{StaticResource Caption}"/>
                                <TextBox Style="{StaticResource InputBox}" Width="320"
                                         Text="{Binding Payload, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="LHOST" Style="{StaticResource Caption}"/>
                                <TextBox Style="{StaticResource InputBox}" Width="140"
                                         Text="{Binding PlHost, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="LPORT" Style="{StaticResource Caption}"/>
                                <TextBox Style="{StaticResource InputBox}" Width="90"
                                         Text="{Binding PlPort, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Format" Style="{StaticResource Caption}"/>
                                <ComboBox Style="{StaticResource ComboDark}" Width="110"
                                          ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}"/>
                            </StackPanel>
                            <Button Content="Generate" Style="{StaticResource BtnPrimary}"
                                    Command="{Binding GeneratePayloadCommand}" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PayloadOutPath, StringFormat='target: {0}'}"
                                   Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
