<Window x:Class="StrykerOSS.Views.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StrykerOSS — Accord de test autorisé"
        Width="620" Height="520" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Width="38" Height="38">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Avant de continuer" Style="{StaticResource H2}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                       Text="StrykerOSS est une suite libre et open source de tests de sécurité, fournie à des fins ÉDUCATIVES uniquement."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="L'éthique d'abord. Tout ce que vous faites avec cet outil relève de votre responsabilité."/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                               Text="&#8226; Scannez, testez ou auditez uniquement des systèmes qui vous appartiennent ou pour lesquels vous disposez d'une autorisation écrite explicite.&#10;&#8226; L'accès non autorisé à des systèmes informatiques est illégal dans la plupart des juridictions.&#10;&#8226; Ce logiciel est distribué dans l'espoir qu'il sera utile pour apprendre la sécurité, sans AUCUNE GARANTIE.&#10;&#8226; Les auteurs et contributeurs ne sauraient être tenus responsables d'un usage abusif ou de dommages causés par ce programme.&#10;&#8226; Obtenez toujours une autorisation. Respectez les systèmes et les données. Restez éthique."/>
                    <TextBlock Style="{StaticResource Section}" Margin="0,16,0,4" Text="LICENCE"/>
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Ce programme est un logiciel libre : vous pouvez le redistribuer et/ou le modifier selon les termes de la GNU General Public License v3.0. Portage Windows inspiré de zalexdev/strykerapp (GPL-3.0)."/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2">
            <CheckBox x:Name="ChkAgree" Foreground="{StaticResource TextBrush}" FontSize="13"
                      Content="Je testerai uniquement des systèmes qui m'appartiennent ou pour lesquels j'ai une autorisation explicite."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Quitter" Style="{StaticResource BtnGhost}" Click="OnExit" Margin="0,0,10,0"/>
                <Button x:Name="BtnAccept" Content="Accepter et continuer" Style="{StaticResource BtnPrimary}"
                        IsEnabled="False" Click="OnAccept"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
