<Window x:Class="StrykerOSS.Views.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StrykerOSS - Authorized testing agreement"
        Width="620" Height="520" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Width="38" Height="38">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Before you continue" Style="{StaticResource H2}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                       Text="StrykerOSS is a free and open-source security testing suite, provided for EDUCATIONAL purposes only."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Text="Ethics first. Everything you do with this tool is your responsibility."/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                               Text="&#8226; Only scan, test or audit systems you own or have explicit written permission to test.&#10;&#8226; Unauthorized access to computer systems is illegal in most jurisdictions.&#10;&#8226; This software is distributed in the hope that it will be useful for learning security, with ABSOLUTELY NO WARRANTY.&#10;&#8226; The authors and contributors are not responsible for any misuse or damage caused by this program.&#10;&#8226; Always get permission. Respect systems and data. Stay ethical."/>
                    <TextBlock Style="{StaticResource Section}" Margin="0,16,0,4" Text="LICENSE"/>
                    <TextBlock Style="{StaticResource Caption}"
                               Text="This program is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License v3.0. Windows port inspired by zalexdev/strykerapp (GPL-3.0)."/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2">
            <CheckBox x:Name="ChkAgree" Foreground="{StaticResource TextBrush}" FontSize="13"
                      Content="I will only test systems I own or have explicit permission to test."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Exit" Style="{StaticResource BtnGhost}" Click="OnExit" Margin="0,0,10,0"/>
                <Button x:Name="BtnAccept" Content="Accept and continue" Style="{StaticResource BtnPrimary}"
                        IsEnabled="False" Click="OnAccept"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
