<UserControl x:Class="StrykerOSS.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BgBrush}" TextElement.Foreground="{StaticResource TextBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Projects" Style="{StaticResource H1}"/>
            <TextBlock Text="Engagement records, findings and notes stored in local SQLite. Backups export as real .zip archives." Style="{StaticResource Caption}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ LEFT COLUMN ============ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
                <StackPanel>

                    <!-- projects list -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PROJECTS" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Refresh" Style="{StaticResource BtnGhost}" Command="{Binding ReloadCommand}"/>
                            </Grid>
                            <TextBlock Text="No projects yet - create one below."
                                       Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Projects.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Projects}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                    BorderThickness="0" Padding="12,10"
                                                    Command="{Binding DataContext.SelectProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}"/>
                                                </Button.Style>
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <Border x:Name="bActive" Grid.Column="1" Style="{StaticResource BadgeSuccess}">
                                                            <TextBlock Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                        </Border>
                                                        <Border x:Name="bDone" Grid.Column="1" Style="{StaticResource BadgeInfo}" Visibility="Collapsed">
                                                            <TextBlock Text="COMPLETED" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Client, StringFormat='client {0}'}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Updated, StringFormat='updated {0:yyyy-MM-dd HH:mm}'}" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                    <Setter TargetName="bActive" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="bDone" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- new project -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="NEW PROJECT" Style="{StaticResource Section}"/>
                            <TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Client" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding NewProjectClient, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Description" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                            <TextBox Style="{StaticResource InputBox}" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding NewProjectDescription, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Create project" Style="{StaticResource BtnPrimary}" Command="{Binding CreateProjectCommand}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- danger zone -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="DANGER ZONE" Style="{StaticResource Section}"/>
                            <CheckBox Content="I understand: this deletes the selected project with all its findings and notes"
                                      Foreground="{StaticResource DimBrush}" FontSize="12"
                                      IsChecked="{Binding ConfirmDelete, Mode=TwoWay}"/>
                            <Button Content="Delete selected project" Style="{StaticResource BtnDanger}"
                                    Command="{Binding DeleteProjectCommand}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ RIGHT COLUMN ============ -->
            <Grid Grid.Column="1">
                <!-- empty state: visible only when no project is selected -->
                <TextBlock Text="Select a project on the left to manage its findings and notes.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- detail: hidden while no project is selected -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>

                        <!-- project summary -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedProject.Name}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Export backup (.zip)" Style="{StaticResource BtnGhost}"
                                            Command="{Binding ExportBackupCommand}"/>
                                </Grid>
                                <TextBlock Text="{Binding SelectedProject.Client, StringFormat='client: {0}'}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding SelectedProject.Description}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding SelectedProject.Created, StringFormat='created {0:yyyy-MM-dd HH:mm}'}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </Border>

                        <!-- findings -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Findings.Count, StringFormat='FINDINGS ({0})'}" Style="{StaticResource Section}"/>
                                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Findings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- severity badge: critical/high danger, medium warn, low info, info muted -->
                                                            <Border x:Name="svCrit" Style="{StaticResource BadgeDanger}" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                            </Border>
                                                            <Border x:Name="svMed" Style="{StaticResource BadgeWarn}" Visibility="Collapsed" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                            </Border>
                                                            <Border x:Name="svLow" Style="{StaticResource BadgeInfo}" Visibility="Collapsed" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                            </Border>
                                                            <Border x:Name="svInfo" Style="{StaticResource BadgeMuted}" Visibility="Collapsed" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                            </Border>
                                                            <Button Content="Delete" Style="{StaticResource BtnDanger}" Padding="10,4"
                                                                    Command="{Binding DataContext.DeleteFindingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="medium">
                                                        <Setter TargetName="svCrit" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="svMed" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="low">
                                                        <Setter TargetName="svCrit" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="svLow" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="info">
                                                        <Setter TargetName="svCrit" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="svInfo" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- add finding -->
                                <TextBlock Text="ADD FINDING" Style="{StaticResource Section}" Margin="0,12,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Title" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource InputBox}" Text="{Binding NewFindingTitle, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Severity" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                        <ComboBox Style="{StaticResource ComboDark}" Width="140" MinWidth="140"
                                                  ItemsSource="{Binding Severities}" SelectedItem="{Binding NewFindingSeverity}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Description" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                                <TextBox Style="{StaticResource InputBox}" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding NewFindingDescription, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Impact" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding NewFindingImpact, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Proof of concept" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                                <TextBox Style="{StaticResource InputBox}" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                                         FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                                         Text="{Binding NewFindingPoc, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Remediation" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                                <TextBox Style="{StaticResource InputBox}" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding NewFindingRemediation, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="Add finding" Style="{StaticResource BtnPrimary}" Command="{Binding AddFindingCommand}"
                                        Margin="0,12,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- notes -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Notes.Count, StringFormat='NOTES ({0})'}" Style="{StaticResource Section}"/>
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Notes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Body}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Delete" Style="{StaticResource BtnDanger}" Padding="10,4" VerticalAlignment="Center"
                                                                Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Text="ADD NOTE" Style="{StaticResource Section}" Margin="0,12,0,4"/>
                                <TextBlock Text="Title" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding NewNoteTitle, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Body" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                                <TextBox Style="{StaticResource InputBox}" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding NewNoteBody, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="Add note" Style="{StaticResource BtnPrimary}" Command="{Binding AddNoteCommand}"
                                        Margin="0,12,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="4,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
