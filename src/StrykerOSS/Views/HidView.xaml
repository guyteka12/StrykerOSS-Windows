<UserControl x:Class="StrykerOSS.Views.HidView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BgBrush}" TextElement.Foreground="{StaticResource TextBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Attaques HID" Style="{StaticResource H1}"/>
            <TextBlock Text="Exécution réelle de DuckyScript sur cette machine via Win32 SendInput."
                       Style="{StaticResource Caption}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- ============ left: warning + script + log ============ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- educational warning card -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource BadgeWarn}" Margin="0,0,12,0" VerticalAlignment="Top">
                            <TextBlock Text="ATTENTION" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                        </Border>
                        <TextBlock Style="{StaticResource Body}" MaxWidth="660"
                                   Text="Les attaques HID exécutent des frappes clavier sur CETTE machine. Placez le focus sur une fenêtre cible sûre (ex. le Bloc-notes) avant d'exécuter. Usage éducatif."/>
                    </StackPanel>
                </Border>

                <!-- script card -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="DUCKYSCRIPT" Style="{StaticResource Section}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Ouvrir .duck / .txt" Style="{StaticResource BtnPrimary}"
                                    Command="{Binding OpenScriptCommand}"/>
                            <Button Content="Créer un exemple sûr" Style="{StaticResource BtnGhost}" Margin="10,0,0,0"
                                    Command="{Binding MakeSampleCommand}"/>
                            <Button Content="EXÉCUTER LE SCRIPT" Style="{StaticResource BtnDanger}" Margin="10,0,0,0"
                                    Command="{Binding RunCommand}"/>
                            <Button Content="ARRÊTER" Style="{StaticResource BtnGhost}" Margin="10,0,0,0"
                                    Command="{Binding StopCommand}"/>
                        </StackPanel>
                        <CheckBox Content="Je confirme que la fenêtre au premier plan est une cible sûre"
                                  IsChecked="{Binding ConfirmExecute, Mode=TwoWay}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding ScriptPath}" FontFamily="Consolas" FontSize="12"
                                   Foreground="{StaticResource DimBrush}" Margin="0,10,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ScriptSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- live log -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="JOURNAL EN DIRECT" Style="{StaticResource Section}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LogLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource DimBrush}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ============ right: info ============ -->
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="FONCTIONNEMENT" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                                   Text="Chaque ligne est exécutée avec de vrais événements Win32 SendInput : les touches sont pressées et relâchées exactement comme le ferait un USB Rubber Ducky."/>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Le texte STRING est mappé via la disposition clavier Windows ACTIVE (VkKeyScanW), donc les dispositions non-US comme AZERTY saisissent correctement."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="SYNTAXE PRISE EN CHARGE" Style="{StaticResource Section}"/>
                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource DimBrush}"
                                   Text="REM / REM BLOCK&#x0a;DELAY &lt;ms&gt;&#x0a;DEFAULTDELAY &lt;ms&gt;&#x0a;STRING &lt;text&gt;&#x0a;STRINGLN &lt;text&gt;&#x0a;REPEAT &lt;n&gt;&#x0a;GUI r / CTRL-ALT-DELETE&#x0a;ENTER TAB ESC SPACE F1-F12 ..."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ÉDUCATIF" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="À n'exécuter que sur des machines que vous possédez ou que vous êtes autorisé à tester. Ce module injecte les entrées localement : il ne cible pas d'autres appareils."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
