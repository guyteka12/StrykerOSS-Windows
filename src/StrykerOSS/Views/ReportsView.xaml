<UserControl x:Class="StrykerOSS.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BgBrush}" TextElement.Foreground="{StaticResource TextBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Reports" Style="{StaticResource H1}"/>
            <TextBlock Text="Real PDF (QuestPDF), HTML and Markdown generation from stored findings. Files land in DataDir/reports." Style="{StaticResource Caption}"/>
        </StackPanel>

        <!-- busy bar -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Margin="0,0,0,10">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar" BasedOn="{StaticResource ProgressAccent}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ GENERATE CARD ============ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="GENERATE REPORT" Style="{StaticResource Section}"/>

                        <TextBlock Text="Project" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                        <ComboBox Style="{StaticResource ComboDark}" ItemsSource="{Binding Projects}"
                                  DisplayMemberPath="Name" SelectedItem="{Binding SelectedProject}"/>

                        <TextBlock Text="Title" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Author" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Format" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                        <ComboBox Style="{StaticResource ComboDark}" Width="180" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}"/>

                        <TextBlock Text="Executive summary (optional)" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                        <TextBox Style="{StaticResource InputBox}" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding ExecSummary, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Content="Generate report" Style="{StaticResource BtnPrimary}"
                                Command="{Binding GenerateCommand}" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- ============ REPORTS LIST ============ -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="GENERATED REPORTS" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Refresh" Style="{StaticResource BtnGhost}" Command="{Binding ReloadCommand}"/>
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="No reports generated yet - fill the form on the left."
                                   Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Reports.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Reports}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <!-- format badge: pdf danger, html info, markdown muted -->
                                                        <Border x:Name="fmtPdf" Style="{StaticResource BadgeDanger}" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Format}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                        </Border>
                                                        <Border x:Name="fmtHtml" Style="{StaticResource BadgeInfo}" Visibility="Collapsed" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Format}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                        </Border>
                                                        <Border x:Name="fmtMd" Style="{StaticResource BadgeMuted}" Visibility="Collapsed" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Format}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding Created, StringFormat='created {0:yyyy-MM-dd HH:mm}'}" Style="{StaticResource Caption}"/>
                                                        <TextBlock Text="{Binding Author, StringFormat='by {0}'}" Style="{StaticResource Caption}" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Open" Style="{StaticResource BtnGhost}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Format}" Value="html">
                                                <Setter TargetName="fmtPdf" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="fmtHtml" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Format}" Value="markdown">
                                                <Setter TargetName="fmtPdf" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="fmtMd" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
