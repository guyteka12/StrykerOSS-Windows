<UserControl x:Class="StrykerOSS.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgBrush}" TextElement.Foreground="{StaticResource TextBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Settings" Style="{StaticResource H1}"/>
            <TextBlock Text="Tool paths, Metasploit RPC, author signature and system info - stored in %LOCALAPPDATA%\StrykerOSS\settings.json."
                       Style="{StaticResource Caption}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ left column ============ -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TOOL PATHS" Style="{StaticResource Section}"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Nmap" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}"
                                     Text="{Binding NmapPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Content="Browse..." Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                                    Command="{Binding BrowsePathCommand}" CommandParameter="nmap"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Nuclei" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}"
                                     Text="{Binding NucleiPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Content="Browse..." Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                                    Command="{Binding BrowsePathCommand}" CommandParameter="nuclei"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MsfVenom" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}"
                                     Text="{Binding MsfPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Content="Browse..." Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                                    Command="{Binding BrowsePathCommand}" CommandParameter="msf"/>
                        </Grid>

                        <Button Content="Auto-detect all" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left"
                                Command="{Binding AutoDetectCommand}"/>
                        <TextBlock Text="Auto-detect scans Settings paths, the tools dir, PATH and common install locations."
                                   Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="MSF RPC" Style="{StaticResource Section}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Host" Style="{StaticResource Caption}"/>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding MsfRpcHost, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Port" Style="{StaticResource Caption}"/>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding MsfRpcPort}"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="User" Style="{StaticResource Caption}"/>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding MsfRpcUser, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Password" Style="{StaticResource Caption}"/>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding MsfRpcPass, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Used by the Metasploit module (msfrpcd -P &lt;pass&gt; -S -p 55553 -a 127.0.0.1)."
                                   Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="REPORT AUTHOR" Style="{StaticResource Section}"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding DefaultAuthor, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Signature written into generated reports." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ right column ============ -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="SYSTEM" Style="{StaticResource Section}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource BadgeSuccess}"
                                    Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="ADMIN / ELEVATED" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                            </Border>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource BadgeWarn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsElevated}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="WARNING — NOT ELEVATED" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding WindowsVersion, StringFormat='OS: {0}'}" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding MachineName, StringFormat='Machine: {0}'}" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding CurrentUser, StringFormat='User: {0}'}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="DATA" Style="{StaticResource Section}"/>
                        <TextBlock Text="{Binding DataDir, StringFormat='Data dir: {0}'}" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ToolsDir, StringFormat='Tools dir: {0}'}" Style="{StaticResource Caption}" Margin="0,0,10,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Open data folder" Style="{StaticResource BtnGhost}" Command="{Binding OpenDataFolderCommand}"/>
                            <Button Content="Save" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Command="{Binding SaveCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
