<UserControl x:Class="StrykerOSS.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgBrush}" TextElement.Foreground="{StaticResource TextBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Console" Style="{StaticResource H1}"/>
            <TextBlock Text="Vrai shell interactif élevé (powershell / cmd / wsl) avec stdin/stdout redirigés."
                       Style="{StaticResource Caption}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- main console card -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <!-- toolbar -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="SHELL" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Style="{StaticResource ComboDark}" Width="150" VerticalAlignment="Center"
                                  ItemsSource="{Binding Shells}" SelectedItem="{Binding SelectedShell}"/>
                        <Button Content="Démarrer" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0"
                                Command="{Binding StartCommand}"/>
                        <Button Content="Arrêter" Style="{StaticResource BtnDanger}" Margin="8,0,0,0"
                                Command="{Binding StopCommand}"/>

                        <Border Style="{StaticResource BadgeSuccess}" Margin="14,0,0,0"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Pid, StringFormat='EN COURS · PID {0}', TargetNullValue='EN COURS'}"
                                       FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                        </Border>
                        <Border Margin="14,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource BadgeMuted}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="ARRÊTÉ" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                        </Border>

                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- command input -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBox Style="{StaticResource InputBox}" Width="520"
                                 Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Envoyer" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0"
                                IsDefault="True" Command="{Binding SendCommand}"/>
                    </StackPanel>

                    <!-- output -->
                    <ListBox Background="{StaticResource Card2Brush}" BorderThickness="0" Padding="8"
                             ItemsSource="{Binding Lines}" FontFamily="Consolas" FontSize="12"
                             Foreground="{StaticResource TextBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VirtualizingPanel.ScrollUnit="Pixel"/>
                </DockPanel>
            </Border>

            <!-- side column -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="REMARQUE" Style="{StaticResource Section}"/>
                        <TextBlock Text="Vrai shell élevé (cette application s'exécute en tant qu'Administrateur). Usage éducatif uniquement."
                                   Style="{StaticResource Body}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="SHELLS" Style="{StaticResource Section}"/>
                        <TextBlock Text="powershell — Windows PowerShell 5.1, interactif via stdin (stratégie d'exécution Bypass)."
                                   Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                        <TextBlock Text="cmd — cmd.exe /Q /K, shell batch classique." Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                        <TextBlock Text="wsl — shell de la distribution WSL par défaut ; nécessite WSL installé (wsl --install)."
                                   Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                        <TextBlock Text="La sortie est limitée à 2000 lignes ; les commandes commençant par &gt; sont les vôtres."
                                   Style="{StaticResource Caption}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
