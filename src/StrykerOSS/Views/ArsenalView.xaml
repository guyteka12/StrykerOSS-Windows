<UserControl x:Class="StrykerOSS.Views.ArsenalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BgBrush}" TextElement.Foreground="{StaticResource TextBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Arsenal" Style="{StaticResource H1}"/>
            <TextBlock Text="Modèles de commandes personnalisés de scan/exploit - exécution réelle sur cette machine. Ciblez uniquement des systèmes que vous êtes autorisé à tester."
                       Style="{StaticResource Caption}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ templates list ============ -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Nouveau" Style="{StaticResource BtnGhost}" Command="{Binding NewTemplateCommand}"/>
                        <Button Content="Dupliquer" Style="{StaticResource BtnGhost}" Command="{Binding DuplicateTemplateCommand}" Margin="8,0,0,0"/>
                        <Button Content="Initialiser" Style="{StaticResource BtnGhost}" Command="{Binding SeedCommand}" Margin="8,0,0,0"
                                ToolTip="Ajoute les 6 modèles intégrés lorsque la liste est vide"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="MODÈLES" Style="{StaticResource Section}"/>
                    <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding Templates}"
                             SelectedItem="{Binding SelectedTemplate}" ItemContainerStyle="{StaticResource NavListBoxItem}"
                             VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                        <Border Style="{StaticResource BadgeMuted}" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Command}" Style="{StaticResource Caption}"
                                               FontFamily="Consolas" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ============ right: editor + execute ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- edit panel -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="MODIFIER LE MODÈLE" Style="{StaticResource Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Nom" Style="{StaticResource Caption}"/>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Catégorie" Style="{StaticResource Caption}"/>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding EditCategory, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Commande - jetons : {IP} {PORT} {MAC} {GW} {MASK} {TARGET_URL}"
                                   Style="{StaticResource Caption}" Margin="0,8,0,2"/>
                        <TextBox Style="{StaticResource InputBox}" AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                 Text="{Binding EditCommand, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Description" Style="{StaticResource Caption}" Margin="0,8,0,2"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Enregistrer" Style="{StaticResource BtnPrimary}" Command="{Binding SaveTemplateCommand}"/>
                            <Button Content="Supprimer" Style="{StaticResource BtnDanger}" Command="{Binding DeleteTemplateCommand}" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- execute card -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="EXÉCUTER" Style="{StaticResource Section}"/>
                            <UniformGrid Columns="5">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="IP" Style="{StaticResource Caption}"/>
                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding ExeIp, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="PORT" Style="{StaticResource Caption}"/>
                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding ExePort, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="MAC" Style="{StaticResource Caption}"/>
                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding ExeMac, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="GW" Style="{StaticResource Caption}"/>
                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding ExeGw, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="MASK" Style="{StaticResource Caption}"/>
                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding ExeMask, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Commande générée" Style="{StaticResource Caption}" Margin="0,10,0,2"/>
                            <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="10,8">
                                <TextBlock Text="{Binding Preview}" Style="{StaticResource Body}" FontFamily="Consolas"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Exécuter" Style="{StaticResource BtnPrimary}" Command="{Binding ExecuteCommand}"/>
                                <Button Content="Annuler" Style="{StaticResource BtnDanger}" Command="{Binding CancelExecuteCommand}"
                                        Margin="8,0,0,0" IsEnabled="{Binding IsBusy}"/>
                                <TextBlock Text="Rappel pédagogique : n'exécutez que sur des systèmes que vous êtes autorisé à tester."
                                           Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding Output}"
                                 FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextBrush}"
                                 Margin="0,10,0,0" VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
