<UserControl x:Class="StrykerOSS.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BgBrush}" TextElement.Foreground="{StaticResource TextBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Sessions" Style="{StaticResource H1}"/>
            <TextBlock Text="Track operator sessions locally and inspect live Metasploit RPC sessions side by side." Style="{StaticResource Caption}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ LEFT: local sessions ============ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="LOCAL SESSIONS" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Refresh" Style="{StaticResource BtnGhost}" Command="{Binding ReloadCommand}"/>
                            </Grid>
                            <TextBlock Text="No sessions on record - start one below."
                                       Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Sessions.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Sessions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <!-- kind badge: nmap info, nuclei warn, msf danger, terminal success, default muted -->
                                                            <Border x:Name="kbDef" Style="{StaticResource BadgeMuted}" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                            </Border>
                                                            <Border x:Name="kbNmap" Style="{StaticResource BadgeInfo}" Visibility="Collapsed" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                            </Border>
                                                            <Border x:Name="kbNuclei" Style="{StaticResource BadgeWarn}" Visibility="Collapsed" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                            </Border>
                                                            <Border x:Name="kbMsf" Style="{StaticResource BadgeDanger}" Visibility="Collapsed" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                            </Border>
                                                            <Border x:Name="kbTerm" Style="{StaticResource BadgeSuccess}" Visibility="Collapsed" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                            </Border>
                                                            <!-- active badge while Ended is null -->
                                                            <Border x:Name="sbAct" Style="{StaticResource BadgeSuccess}" Visibility="Collapsed">
                                                                <TextBlock Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                            </Border>
                                                            <Border x:Name="sbEnd" Style="{StaticResource BadgeMuted}">
                                                                <TextBlock Text="ENDED" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding Target, StringFormat='target {0}'}" Style="{StaticResource Caption}"/>
                                                        <TextBlock Text="{Binding Started, StringFormat='started {0:yyyy-MM-dd HH:mm}'}" Style="{StaticResource Caption}"/>
                                                        <TextBlock Text="{Binding Ended, StringFormat='ended {0:yyyy-MM-dd HH:mm}'}" Style="{StaticResource Caption}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button x:Name="btnEnd" Content="End" Style="{StaticResource BtnGhost}" Padding="10,4" Margin="0,0,8,0" Visibility="Collapsed"
                                                                Command="{Binding DataContext.EndSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Content="Delete" Style="{StaticResource BtnDanger}" Padding="10,4"
                                                                Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="nmap">
                                                    <Setter TargetName="kbDef" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="kbNmap" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="nuclei">
                                                    <Setter TargetName="kbDef" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="kbNuclei" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="msf">
                                                    <Setter TargetName="kbDef" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="kbMsf" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="terminal">
                                                    <Setter TargetName="kbDef" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="kbTerm" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Ended}" Value="{x:Null}">
                                                    <Setter TargetName="sbAct" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="sbEnd" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="btnEnd" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- start session -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="START SESSION" Style="{StaticResource Section}"/>
                            <TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding NewSessionName, UpdateSourceTrigger=PropertyChanged}"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Target" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource InputBox}" Text="{Binding NewSessionTarget, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Kind" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <ComboBox Style="{StaticResource ComboDark}" Width="140" MinWidth="140"
                                              ItemsSource="{Binding Kinds}" SelectedItem="{Binding NewSessionKind}"/>
                                </StackPanel>
                            </Grid>
                            <Button Content="Start session" Style="{StaticResource BtnPrimary}" Command="{Binding StartSessionCommand}"
                                    Margin="0,12,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ RIGHT: metasploit live sessions ============ -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="METASPLOIT RPC" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center"/>
                                <Border Margin="8,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource BadgeSuccess}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MsfConnected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="CONNECTED" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Refresh" Style="{StaticResource BtnGhost}" Command="{Binding RefreshMsfCommand}"/>
                        </Grid>

                        <!-- disconnected hint -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MsfConnected}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Not connected to the Metasploit RPC. Start msfrpcd (e.g. 'msfrpcd -P yourpass -S false') or run 'load msgrpc' inside msfconsole, then connect. Host/port/user come from the app settings."/>
                            <Button Content="Connect MSF RPC" Style="{StaticResource BtnPrimary}" Command="{Binding ConnectMsfCommand}"
                                    Margin="0,10,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- connected list -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MsfConnected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding MsfSessions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Style="{StaticResource BadgeDanger}" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Id, StringFormat='#{0}'}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Type}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding TunnelPeer, StringFormat='peer {0}'}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding TargetHost, StringFormat='host {0}'}" Style="{StaticResource Caption}"/>
                                                        <TextBlock Text="{Binding Platform, StringFormat='platform {0}'}" Style="{StaticResource Caption}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Kill" Style="{StaticResource BtnDanger}" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.KillMsfCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="No live MSF sessions right now."
                                       Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MsfSessions.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- educational note -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="NOTE" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Local sessions are an audit trail of what you did and when (stored in SQLite). Metasploit sessions are read live from the real MSGRPC endpoint - killing a session terminates it on the framework side. Only use against systems you are authorized to test."/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="4,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
