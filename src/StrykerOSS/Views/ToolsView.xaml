<UserControl x:Class="StrykerOSS.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgBrush}" TextElement.Foreground="{StaticResource TextBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- en-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Gestionnaire d'outils" Style="{StaticResource H1}"/>
            <TextBlock Text="Détection réelle (chemin + sonde de version) et installation réelle des outils de test d'intrusion sur Windows."
                       Style="{StaticResource Caption}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DockPanel>
                <!-- barre d'outils -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="Actualiser" Style="{StaticResource BtnGhost}" Command="{Binding RefreshCommand}"/>
                    <Button Content="Ouvrir le dossier des outils" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                            Command="{Binding OpenToolsDirCommand}"/>
                    <Button Content="Relancer l'assistant d'installation" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0"
                            Command="{Binding OpenSetupWizardCommand}"/>
                    <TextBlock Text="{Binding ToolsDir, StringFormat='Dossier des outils : {0}'}" Style="{StaticResource Caption}"
                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,0,0,10"/>

                <!-- liste des outils -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Tools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Card2Brush}" CornerRadius="10"
                                        Padding="12,8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- trouvé -->
                                        <StackPanel Grid.Column="0" Visibility="{Binding Found, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                                <Border Style="{StaticResource BadgeSuccess}" Margin="10,0,0,0">
                                                    <TextBlock Text="INSTALLÉ" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Version, StringFormat='Version : {0}'}" Style="{StaticResource Caption}"/>
                                        </StackPanel>

                                        <!-- non trouvé -->
                                        <StackPanel Grid.Column="0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Found}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                                <Border Style="{StaticResource BadgeMuted}" Margin="10,0,0,0">
                                                    <TextBlock Text="INTROUVABLE" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding InstallHint}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="Installer" Style="{StaticResource BtnPrimary}"
                                                VerticalAlignment="Center" Margin="12,0,0,0"
                                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Key}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
