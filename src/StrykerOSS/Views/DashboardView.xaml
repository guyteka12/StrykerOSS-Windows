<UserControl x:Class="StrykerOSS.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BgBrush}" TextElement.Foreground="{StaticResource TextBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Dashboard" Style="{StaticResource H1}"/>
            <TextBlock Text="Mission control - every module writes real results into the local SQLite store." Style="{StaticResource Caption}"/>
        </StackPanel>

        <!-- busy bar -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Margin="0,0,0,10">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar" BasedOn="{StaticResource ProgressAccent}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- welcome card -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Welcome back" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="{Binding AdminLine}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Margin="0,0,8,0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource BadgeSuccess}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsElevated}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="ELEVATED" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                            </Border>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource BadgeWarn}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsElevated}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="NOT ELEVATED" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- stats grid 2x4 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="OVERVIEW" Style="{StaticResource Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent2Brush}"/>
                                    <TextBlock Text="{Binding ScansCount}" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <TextBlock Text="Scans" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent2Brush}"/>
                                    <TextBlock Text="{Binding FindingsCount}" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <TextBlock Text="Findings" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource DangerBrush}"/>
                                    <TextBlock Text="{Binding CriticalCount}" FontSize="30" FontWeight="Bold" Margin="0,6,0,0" Foreground="{StaticResource DangerBrush}"/>
                                    <TextBlock Text="Critical" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="3" Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent2Brush}"/>
                                    <TextBlock Text="{Binding ReportsCount}" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <TextBlock Text="Reports" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent2Brush}"/>
                                    <TextBlock Text="{Binding SessionsCount}" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <TextBlock Text="Sessions" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent2Brush}"/>
                                    <TextBlock Text="{Binding HandshakesCount}" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <TextBlock Text="Handshakes" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent2Brush}"/>
                                    <TextBlock Text="{Binding TemplatesCount}" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <TextBlock Text="Templates" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="3" Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="&#xE739;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent2Brush}"/>
                                    <TextBlock Text="{Binding GeoPointsCount}" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/>
                                    <TextBlock Text="GeoPoints" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- quick actions -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="QUICK ACTIONS" Style="{StaticResource Section}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Wi-Fi scan" Style="{StaticResource BtnPrimary}" Command="{Binding OpenWifiCommand}" Margin="0,0,8,0"/>
                            <Button Content="Discover LAN" Style="{StaticResource BtnPrimary}" Command="{Binding OpenLanCommand}" Margin="0,0,8,0"/>
                            <Button Content="Nmap" Style="{StaticResource BtnPrimary}" Command="{Binding OpenNmapCommand}" Margin="0,0,8,0"/>
                            <Button Content="Web scan" Style="{StaticResource BtnPrimary}" Command="{Binding OpenNucleiCommand}" Margin="0,0,8,0"/>
                            <Button Content="New project" Style="{StaticResource BtnGhost}" Command="{Binding OpenProjectsCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- recent scans -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RECENT SCANS" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Refresh" Style="{StaticResource BtnGhost}" Command="{Binding RefreshCommand}"/>
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="No scans recorded yet - run a scan from Wi-Fi, LAN, Nmap or the Web scanner module."
                                       Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecentScans.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RecentScans}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource BadgeInfo}" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Tool}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Target}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Started, StringFormat='yyyy-MM-dd HH:mm'}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DurationMs, StringFormat={}{0} ms}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- educational footer -->
                <TextBlock Style="{StaticResource Caption}" Margin="4,2,0,6"
                           Text="Educational platform - Windows port of zalexdev/strykerapp (GPL-3.0). Use only against networks and systems you are authorized to test. All data stays on this machine."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
