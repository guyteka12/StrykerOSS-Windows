<UserControl x:Class="StrykerOSS.Views.WhisperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </UserControl.Resources>
    <Grid Background="{StaticResource BgBrush}" TextElement.Foreground="{StaticResource TextBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="WhisperPair (BLE)" Style="{StaticResource H1}"/>
            <TextBlock Text="Real Bluetooth LE advertisement discovery, Fast Pair decoding and GATT enumeration."
                       Style="{StaticResource Caption}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- main column -->
            <StackPanel Grid.Column="0">

                <!-- devices -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="DEVICES" Style="{StaticResource Section}"/>
                        <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding Devices}" Height="330"
                                 SelectedItem="{Binding SelectedDevice}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Body}" FontWeight="Bold"/>
                                                <Border Style="{StaticResource BadgeInfo}" Margin="10,0,0,0"
                                                        Visibility="{Binding IsFastPair, Converter={StaticResource B2V}}">
                                                    <TextBlock Text="FAST PAIR" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                </Border>
                                                <Border Style="{StaticResource BadgeMuted}" Margin="6,0,0,0"
                                                        Visibility="{Binding HasCompany, Converter={StaticResource B2V}}">
                                                    <TextBlock Text="{Binding Company}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Address}" Style="{StaticResource Caption}"/>
                                                <TextBlock Text="{Binding Rssi, StringFormat=' · {0} dBm'}" Style="{StaticResource Caption}"/>
                                                <TextBlock Text="{Binding ModelId, StringFormat=' · model {0}'}" Style="{StaticResource Caption}"/>
                                                <TextBlock Text="{Binding LastSeen, StringFormat=' · seen {0}'}" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- gatt -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="GATT SERVICES" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center"/>
                            <Button Content="Enumerate GATT" Style="{StaticResource BtnPrimary}"
                                    Command="{Binding EnumerateGattCommand}" Margin="12,0,0,0"/>
                            <TextBlock Text="select a device above, then enumerate its services/characteristics"
                                       Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ListBox Background="Transparent" BorderThickness="0" ItemsSource="{Binding GattLines}" Height="250"
                                 FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextBrush}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- side column -->
            <StackPanel Grid.Column="1">

                <!-- support / scan control -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="BLUETOOTH RADIO" Style="{StaticResource Section}" Margin="0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border Style="{StaticResource BadgeSuccess}"
                                        Visibility="{Binding IsSupported, Converter={StaticResource B2V}}">
                                    <TextBlock Text="BT ON" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                </Border>
                                <Border Style="{StaticResource BadgeDanger}"
                                        Visibility="{Binding IsUnsupported, Converter={StaticResource B2V}}">
                                    <TextBlock Text="BT OFF" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Start scan" Style="{StaticResource BtnPrimary}" Command="{Binding StartScanCommand}"/>
                            <Button Content="Stop" Style="{StaticResource BtnGhost}" Command="{Binding StopScanCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Devices seen:" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding DeviceCount}" Style="{StaticResource Caption}" FontWeight="Bold" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        <TextBlock Text="Bluetooth must be On in Windows settings. Google Fast Pair (0x00E0) payloads are decoded to real model IDs."
                                   Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- educational -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="EDUCATIONAL" Style="{StaticResource Section}"/>
                        <TextBlock Text="Real Bluetooth LE discovery via Windows BLE stack. No external dongle needed."
                                   Style="{StaticResource Caption}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
