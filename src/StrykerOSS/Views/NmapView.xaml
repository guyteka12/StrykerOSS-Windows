<UserControl x:Class="StrykerOSS.Views.NmapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Background="{StaticResource BgBrush}" TextElement.Foreground="{StaticResource TextBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Nmap Scanner" Style="{StaticResource H1}"/>
            <TextBlock Text="Runs the real nmap.exe binary with live output streaming, real XML parsing and HTML report export." Style="{StaticResource Caption}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ============ main column ============ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- run card -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="SCAN" Style="{StaticResource Section}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="230"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Target" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Margin="0,0,12,0"
                                     Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="IP, range, CIDR or hostname - e.g. 192.168.1.0/24"/>
                            <TextBlock Grid.Column="2" Text="Profile" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="3" Style="{StaticResource ComboDark}" DisplayMemberPath="Name"
                                      ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Nmap flags" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Margin="0,0,12,0" FontFamily="Consolas"
                                     Text="{Binding CustomArgs, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Full nmap arguments - prefilled from the selected profile, editable"/>
                            <Button Grid.Column="2" Content="Run" Style="{StaticResource BtnPrimary}" Margin="0,0,10,0"
                                    Command="{Binding RunCommand}"/>
                            <Button Grid.Column="3" Content="Cancel" Style="{StaticResource BtnDanger}"
                                    Command="{Binding RunCancelCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding ProfileDescription}" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,4,0,0" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- results card -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="RESULTS" Style="{StaticResource Section}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="No scan results yet - run a scan." Style="{StaticResource Caption}" Margin="0,0,0,8"
                                           Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}"/>
                                <ItemsControl ItemsSource="{Binding Hosts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Card2Brush}" BorderBrush="{StaticResource LineBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding HostLabel}" Style="{StaticResource Body}" FontWeight="Bold" FontFamily="Consolas"/>
                                                        <Border Style="{StaticResource BadgeSuccess}" Margin="10,0,0,0"
                                                                Visibility="{Binding Up, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="UP" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                        </Border>
                                                        <Border Margin="8,0,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource BadgeMuted}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Up}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="DOWN" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding MacLabel}" Style="{StaticResource Caption}" Margin="0,3,0,0" FontFamily="Consolas"
                                                               Visibility="{Binding HasMac, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding OsLabel}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                               Visibility="{Binding HasOs, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding PortSummary}" Style="{StaticResource Caption}" Margin="0,2,0,0" FontWeight="SemiBold"/>
                                                    <ItemsControl ItemsSource="{Binding Ports}" Margin="12,6,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <Border CornerRadius="999" Padding="10,3" VerticalAlignment="Center">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border" BasedOn="{StaticResource BadgeMuted}">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding State}" Value="open">
                                                                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding State}" Value="filtered">
                                                                                        <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding State}" Value="unfiltered">
                                                                                        <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="{Binding State}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Display}" Style="{StaticResource Caption}" Margin="8,0,0,0"
                                                                               FontFamily="Consolas" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- live log card -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="LIVE OUTPUT" Style="{StaticResource Section}"/>
                        <ListBox Background="Transparent" BorderThickness="0"
                                 ItemsSource="{Binding LogLines}"
                                 FontFamily="Consolas" FontSize="12"
                                 Foreground="{StaticResource TextBrush}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 MaxHeight="200"
                                 VirtualizingPanel.ScrollUnit="Pixel"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ============ side column ============ -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="OUTPUT" Style="{StaticResource Section}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Export HTML" Style="{StaticResource BtnPrimary}" Command="{Binding ExportHtmlCommand}"/>
                            <Button Content="Open raw XML" Style="{StaticResource BtnGhost}" Margin="10,0,0,0"
                                    Command="{Binding OpenXmlCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LastXmlPath}" Style="{StaticResource Caption}" Margin="0,8,0,0" FontFamily="Consolas"
                                   Visibility="{Binding HasXml, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PROFILES" Style="{StaticResource Section}"/>
                        <TextBlock Text="{Binding ProfileDescription}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="REMINDER" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                                   Text="nmap performs active scanning: version detection (-sV), OS fingerprinting (-O) and NSE scripts can be logged by the target."/>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Scan only systems you own or are explicitly authorized to test. Educational use only."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
