<UserControl x:Class="StrykerOSS.Views.HandshakesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BgBrush}" TextElement.Foreground="{StaticResource TextBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Handshakes" Style="{StaticResource H1}"/>
            <TextBlock Text="Analyse réelle de handshakes WPA (EAPOL) à partir de captures pcap - export Hashcat 22000."
                       Style="{StaticResource Caption}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- ============ left: analyze + results ============ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ANALYSER LES CAPTURES" Style="{StaticResource Section}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Ouvrir pcap / cap / pcapng..." Style="{StaticResource BtnPrimary}"
                                    Command="{Binding AnalyzeFileCommand}"/>
                            <TextBox Style="{StaticResource InputBox}" Width="280" Margin="10,0,0,0"
                                     ToolTip="Dossier contenant des fichiers .pcap / .cap / .pcapng"
                                     Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Analyser le dossier" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0"
                                    Command="{Binding AnalyzeFolderCommand}"/>
                            <Button Content="Actualiser" Style="{StaticResource BtnGhost}" Margin="10,0,0,0"
                                    Command="{Binding LoadCommand}"/>
                            <Button Content="Exporter en CSV" Style="{StaticResource BtnGhost}" Margin="10,0,0,0"
                                    Command="{Binding ExportCsvCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="CAPTURES" Style="{StaticResource Section}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Card2Brush}"
                                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Body}"
                                                                   FontWeight="SemiBold"/>
                                                        <Border Style="{StaticResource BadgeSuccess}" Margin="10,0,0,0"
                                                                Visibility="{Binding CompleteVis}">
                                                            <TextBlock Text="COMPLET" FontSize="10" FontWeight="Bold"
                                                                       Foreground="#0B0B12"/>
                                                        </Border>
                                                        <Border Style="{StaticResource BadgeWarn}" Margin="10,0,0,0"
                                                                Visibility="{Binding IncompleteVis}">
                                                            <TextBlock Text="INCOMPLET" FontSize="10" FontWeight="Bold"
                                                                       Foreground="#0B0B12"/>
                                                        </Border>
                                                        <Border Style="{StaticResource BadgeMuted}" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding FramesText}" FontSize="10" FontWeight="Bold"
                                                                       Foreground="#0B0B12"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding MetaLine}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding ClientsLine}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <Button Content="Exporter 22000" Style="{StaticResource BtnGhost}" Padding="10,5"
                                                            Margin="0,0,8,0"
                                                            Command="{Binding DataContext.ExportHashCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Supprimer" Style="{StaticResource BtnDanger}" Padding="10,5"
                                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ============ right: notes ============ -->
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource BadgeWarn}">
                                <TextBlock Text="MODE MONITEUR" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="L'adaptateur Wi-Fi intégré de Windows ne peut pas capturer en mode moniteur. Analysez de vraies captures .pcap/.cap depuis votre laboratoire - l'analyse et la conversion Hashcat 22000 sont réelles."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PROCÉDURE" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                                   Text="1. Analysez une capture : le parseur extrait les nonces EAPOL M1-M4, les MIC et les PMKID depuis les octets exacts capturés."/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                                   Text="2. Export 22000 : convertit la meilleure paire AP/client en lignes Hashcat WPA*02 / WPA*01."/>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="3. Craquez hors ligne sur des réseaux dont vous êtes propriétaire : hashcat -m 22000 hash.txt wordlist.txt"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="JOURNAL" Style="{StaticResource Section}"/>
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LogLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource DimBrush}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
