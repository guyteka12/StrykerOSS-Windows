<UserControl x:Class="StrykerOSS.Views.MacChangerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BgBrush}" TextElement.Foreground="{StaticResource TextBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="MAC Changer" Style="{StaticResource H1}"/>
            <TextBlock Text="Real MAC address override via the adapter driver registry key + netsh restart - verified against the live OS state." Style="{StaticResource Caption}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- ================= main column ================= -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- adapter + apply card -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ADAPTER" Style="{StaticResource Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" Style="{StaticResource ComboDark}"
                                      ItemsSource="{Binding Adapters}"
                                      SelectedItem="{Binding SelectedAdapter, Mode=TwoWay}"
                                      DisplayMemberPath="Description"/>
                            <Button Grid.Column="1" Content="Refresh" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                                    Command="{Binding LoadCommand}"/>
                        </Grid>

                        <TextBlock Text="NEW MAC" Style="{StaticResource Section}" Margin="0,12,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource InputBox}" FontFamily="Consolas"
                                     Text="{Binding MacText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="Random" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                                    Command="{Binding RandomMacCommand}"/>
                        </Grid>

                        <TextBlock Text='Confirm - type "APPLY" below to enable the Apply button.' Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                        <TextBox Style="{StaticResource InputBox}" FontFamily="Consolas"
                                 Text="{Binding ApplyConfirm, UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Apply MAC" Style="{StaticResource BtnDanger}" Command="{Binding ApplyCommand}"/>
                            <Button Content="Restore permanent" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                                    Command="{Binding RestoreCommand}"/>
                            <ProgressBar Style="{StaticResource ProgressAccent}" Width="120" IsIndeterminate="{Binding IsBusy}"
                                         VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- profiles card -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="MAC PROFILES" Style="{StaticResource Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                                     Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="Save current" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0"
                                    Command="{Binding SaveProfileCommand}"/>
                        </Grid>
                        <ListBox ItemsSource="{Binding Profiles}"
                                 SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0" MaxHeight="160" Margin="0,10,0,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavListBoxItem}"/>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding Mac}" FontFamily="Consolas" FontSize="12" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{StaticResource DimBrush}"/>
                                        <TextBlock Text="{Binding Created, StringFormat='saved {0:yyyy-MM-dd HH:mm}'}"
                                                   Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Load selected" Style="{StaticResource BtnGhost}" Command="{Binding ApplyProfileCommand}"/>
                            <Button Content="Delete selected" Style="{StaticResource BtnDanger}" Margin="8,0,0,0"
                                    Command="{Binding DeleteProfileCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- log card -->
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="OPERATION LOG" Style="{StaticResource Section}"/>
                        <ListBox ItemsSource="{Binding LogLines}"
                                 Background="Transparent" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="12"
                                 Foreground="{StaticResource TextBrush}"
                                 VirtualizingPanel.ScrollUnit="Pixel"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ================= side column ================= -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- info card -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ADAPTER INFO" Style="{StaticResource Section}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Current MAC" Style="{StaticResource Caption}" Width="120" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentMac}" Style="{StaticResource Body}" FontFamily="Consolas" FontWeight="SemiBold"/>
                                <Border Margin="8,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource BadgeWarn}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOverride}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="OVERRIDE ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Configured MAC" Style="{StaticResource Caption}" Width="120" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ConfiguredMac}" Style="{StaticResource Body}" FontFamily="Consolas"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Medium" Style="{StaticResource Caption}" Width="120" VerticalAlignment="Center"/>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource BadgeInfo}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWireless}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="WI-FI ADAPTER" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                </Border>
                                <Border Margin="8,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource BadgeMuted}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWireless}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="ETHERNET / OTHER" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- warning card -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="WARNING" Style="{StaticResource Section}"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Changing the MAC restarts the adapter — network drops for a few seconds. Requires Administrator (already elevated)."/>
                        </StackPanel>
                    </Border>

                    <!-- educational reminder -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="EDUCATIONAL USE ONLY" Style="{StaticResource Section}"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="MAC spoofing can violate network policies or local law. Use only on networks you own or are explicitly authorized to test."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
