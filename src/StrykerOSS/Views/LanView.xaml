<UserControl x:Class="StrykerOSS.Views.LanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Background="{StaticResource BgBrush}" TextElement.Foreground="{StaticResource TextBrush}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- page header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Réseau local" Style="{StaticResource H1}"/>
            <TextBlock Text="Découverte d'hôtes par ICMP + résolution ARP réelle des adresses MAC (iphlpapi SendARP) + DNS inverse + identification du fabricant via la base IEEE OUI." Style="{StaticResource Caption}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ============ main column ============ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- network card -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="RÉSEAU" Style="{StaticResource Section}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Détecter" Style="{StaticResource BtnPrimary}" Command="{Binding DetectCommand}"/>
                            <Button Content="Découvrir les appareils" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0"
                                    Command="{Binding DiscoverCommand}"/>
                            <Button Content="Annuler" Style="{StaticResource BtnDanger}" Margin="10,0,0,0"
                                    Command="{Binding DiscoverCancelCommand}"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Passerelle" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Gateway}" Style="{StaticResource Body}" FontFamily="Consolas"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="CIDR" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Cidr}" Style="{StaticResource Body}" FontFamily="Consolas"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Progression" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="État" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Caption}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- devices card -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="APPAREILS" Style="{StaticResource Section}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Card2Brush}" BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Ip}" Style="{StaticResource Body}" FontWeight="Bold" FontFamily="Consolas"/>
                                                        <Border Style="{StaticResource BadgeInfo}" Margin="10,0,0,0"
                                                                Visibility="{Binding IsGateway, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="PASSERELLE" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                        </Border>
                                                        <Border Style="{StaticResource BadgeSuccess}" Margin="8,0,0,0"
                                                                Visibility="{Binding Alive, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="ACTIF" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                        </Border>
                                                        <Border Margin="8,0,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource BadgeMuted}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Alive}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="HORS LIGNE" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding StatusNote}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding HostText}" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                                               Visibility="{Binding HasHost, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding MacText}" Style="{StaticResource Caption}" Margin="0,3,0,0" FontFamily="Consolas"/>
                                                    <TextBlock Text="{Binding VendorText}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                               Visibility="{Binding HasVendor, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding LatencyText}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding PortsSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding OpenPortsText}" Style="{StaticResource Caption}" Margin="0,2,0,0" FontFamily="Consolas"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                                                    <Button Content="Ports" Style="{StaticResource BtnGhost}" Padding="10,5"
                                                            Command="{Binding PortsCommand}"/>
                                                    <Button Content="Ping" Style="{StaticResource BtnGhost}" Padding="10,5" Margin="8,0,0,0"
                                                            Command="{Binding PingCommand}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ============ side column ============ -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="RÉSUMÉ" Style="{StaticResource Section}"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding OuiInfo}" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="FONCTIONNEMENT" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                                   Text="« Détecter » lit votre carte réseau active : passerelle IPv4 par défaut et longueur du préfixe de sous-réseau."/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                                   Text="« Découvrir » envoie un ping à chaque hôte du CIDR (délai de 500 ms, 64 en parallèle), puis résout l'adresse MAC de chaque hôte actif via SendARP, le nom d'hôte via DNS inverse et le fabricant via la base IEEE OUI."/>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="« Ports » lance une véritable analyse TCP connect sur 31 ports de services courants ; « Ping » re-sonde un seul hôte."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PÉDAGOGIQUE" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="La découverte réseau est une reconnaissance passive. Ne scannez que les réseaux et les hôtes que vous possédez ou pour lesquels vous êtes explicitement autorisé à tester."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
