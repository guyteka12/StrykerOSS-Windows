<Window x:Class="StrykerOSS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StrykerOSS — Plateforme de tests d'intrusion Windows"
        Height="780" Width="1280" MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <DataTemplate x:Key="NavTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding Label}" FontSize="13"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Width="34" Height="34">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="StrykerOSS" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Plateforme de tests d'intrusion Windows" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource BadgeSuccess}" ToolTip="L'application s'exécute avec les privilèges administrateur Windows">
                        <TextBlock Text="ADMIN" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                    </Border>
                    <Border Style="{StaticResource BadgeMuted}" Margin="8,0,0,0" ToolTip="Usage éducatif uniquement — testez seulement des systèmes qui vous appartiennent ou que vous êtes autorisé à tester">
                        <TextBlock Text="EDUCATIONAL" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Body ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding NavItems}" ItemTemplate="{StaticResource NavTemplate}"
                         ItemContainerStyle="{StaticResource NavListBoxItem}"
                         SelectedValuePath="Key" SelectedValue="{Binding SelectedKey, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel"/>
            </Border>

            <!-- Content -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" Focusable="False"/>
        </Grid>

        <!-- ============ Status bar ============ -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,0">
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource MutedBrush}"
                           Text="v1.1.0 — Usage éducatif uniquement — Sécuriser. Tester. Améliorer."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
