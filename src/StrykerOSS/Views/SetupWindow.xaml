<Window x:Class="StrykerOSS.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StrykerOSS - Première configuration"
        Width="860" Height="640" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- en-tête -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Width="38" Height="38">
                    <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Première configuration" Style="{StaticResource H2}"/>
                    <TextBlock Text="Installez les outils réels dont la plateforme a besoin (aucune simulation). L'installation peut être longue : tout est automatisé."
                               Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- liste des composants -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="COMPOSANTS" Style="{StaticResource Section}"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanInstall}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                                <Border Margin="8,0,0,0" Style="{StaticResource BadgeMuted}" ToolTip="{Binding SizeHint}">
                                                    <TextBlock Text="{Binding SizeHint}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                </Border>
                                                <Border Margin="6,0,0,0" ToolTip="Composant optionnel">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource BadgeInfo}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Optional}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="OPTIONNEL" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource BadgeSuccess}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Installed}" Value="False">
                                                            <Setter Property="Background" Value="{StaticResource MutedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Installing">
                                                            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                                            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                                            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold" Foreground="#0B0B12"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- progression -->
        <ProgressBar Grid.Row="2" x:Name="Progress" Height="6" Margin="0,0,0,10"
                     IsIndeterminate="True" Visibility="Collapsed"
                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource Card2Brush}" BorderThickness="0"/>

        <!-- journal -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10">
            <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                     FontFamily="Consolas" FontSize="12"
                     Foreground="{StaticResource TextBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavListBoxItem}"/>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- boutons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnInstallAll" Content="Tout installer" Style="{StaticResource BtnPrimary}" Click="OnInstallAll"/>
            <Button x:Name="BtnInstallSel" Content="Installer la sélection" Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Click="OnInstallSelected"/>
            <Button x:Name="BtnRefresh" Content="Actualiser la détection" Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Click="OnRefresh"/>
            <Button x:Name="BtnClose" Content="Fermer l'assistant" Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
